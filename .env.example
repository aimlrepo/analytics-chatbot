# LLM Provider Configuration ("openai" or "gemini")
MODEL_PROVIDER=openai

# Model Names
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_NAME=gpt-4o
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MODEL_NAME=gemini-1.5-pro

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Platform (for BigQuery source data)
GCP_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json

# Local gcloud config directory for Docker mount (relative path)
GCLOUD_CONFIG_DIR=./gcloud

# PostgreSQL Checkpointer Connection URL
# For local run outside Docker: postgresql://postgres:postgrespassword@localhost:5432/l2l_chat_memory
# For Docker Compose: postgresql://postgres:postgrespassword@postgres:5432/l2l_chat_memory
POSTGRES_URL=postgresql://postgres:postgrespassword@postgres:5432/l2l_chat_memory
