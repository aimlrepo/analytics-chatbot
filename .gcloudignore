# Files excluded from being uploaded to Google Cloud (Cloud Build / Cloud Run)
.gcloudignore
.git/
.gitignore

# Environment files & secrets
.env
.env.*
!.env.example

# Python compilation & cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments & dependencies
.venv/
venv/
env/
ENV/

# Local database caches (DuckDB files should not be uploaded in build context)
data/*.duckdb
data/*.duckdb.wal
data/*.db
data/*.sqlite*

# Local credentials, service accounts & tokens
gcloud/
credentials/
*.pem
*.key
*.json
!package.json
!tsconfig.json

# Testing & code coverage
.pytest_cache/
.coverage
htmlcov/

# Editor and IDE configurations
.vscode/
.idea/
*.swp
*.swo

# OS temporary files
.DS_Store
Thumbs.db
desktop.ini
